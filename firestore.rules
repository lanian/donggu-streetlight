rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // ---- 역할: roles/{uid} = {role: admin|inspector|resident, name, at, by}
    function signedIn(){ return request.auth != null; }
    function myRole(){ let role=signedIn()?get(/databases/$(db)/documents/roles/$(request.auth.uid)).data:null; return role is map?role.get("role",""):""; }
    function isAdmin(){ return myRole() == "admin"; }
    function isStaff(){ return myRole() in ["admin","inspector"]; }
    function setupDone(){ return exists(/databases/$(db)/documents/meta/setup); }
    function validStatus(value){ return value in ['정상','점검필요','고장','수리중']; }
    function optionalText(data, key, max){ return data.get(key, '') is string && data.get(key, '').size() <= max; }

    // 점검자는 상태·표찰·대표 사진과 좌표 제안만 바꿀 수 있다.
    // 좌표 원본, 광원, 철거, 대장반영, 변경 이력 등은 관리자가 처리한다.
    function lightFieldKeys(){
      return ['status','lastInspected','lastResult','updatedAt','redoNote',
        'code','kind','dong','num','road','main','sub','plateFixed','plateFixedAt',
        'posSuggest','reps','photoId','photoT','photoAt','photoBy','photo','repWide','repPlate','repAround'];
    }
    function validLightFields(data){
      return (!('status' in data) || validStatus(data.status))
        && (!('lastResult' in data) || data.lastResult == null || validStatus(data.lastResult))
        && (!('code' in data) || optionalText(data, 'code', 200))
        && (!('updatedAt' in data) || data.updatedAt is int)
        && (!('lastInspected' in data) || data.lastInspected == null || data.lastInspected is int)
        && (!('posSuggest' in data) || data.posSuggest == null || (data.posSuggest is map
          && data.posSuggest.lat is number && data.posSuggest.lng is number));
    }
    function ownPositionSuggestion(data){
      return data.get('posSuggest', null) is map
        && data.posSuggest.by == request.auth.uid;
    }
    function newFieldLight(id, data){
      // 배포 대장(p...)에 임의의 좌표·철거 정보를 생성하는 우회를 막는다.
      return id.matches('(np|bd|gl)-.+')
        && data.keys().hasOnly(['code','dong','kind','num','road','main','sub','poleNo',
          'address','lampType','status','lastInspected','reg','noPlate','note',
          'foundAt','foundBy','updatedAt','photo','lat','lng','acc'])
        && data.reg == '미등록' && data.foundBy == request.auth.uid
        && data.code is string && data.code.size() > 0 && data.code.size() <= 200
        && data.foundAt is int && data.updatedAt is int
        && data.status == '정상' && data.lastInspected == null
        && (!('lat' in data) || (data.lat is number && data.lat >= -90 && data.lat <= 90))
        && (!('lng' in data) || (data.lng is number && data.lng >= -180 && data.lng <= 180));
    }
    function imageData(value, max){
      return value is string && value.size() <= max
        && (value == '' || value.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'));
    }
    function optionalImage(data,key,max){return data.get(key,null)==null || imageData(data[key],max);}
    // Thumbnail bytes are never used as a remote URL by the client. Validate their
    // shape here; original photo format and provenance are checked separately.
    function validThumb(t){return t is map && t.id is string && t.id.size()<=200
      && t.t is string && t.t.size()<=160000 && optionalText(t,'label',80);}
    function thumbList(data){
      let ts=data.get('thumbs',[]);
      let n=ts is list?ts.size():999;
      return n<=6
        && (n<1 || validThumb(ts[0])) && (n<2 || validThumb(ts[1]))
        && (n<3 || validThumb(ts[2])) && (n<4 || validThumb(ts[3]))
        && (n<5 || validThumb(ts[4])) && (n<6 || validThumb(ts[5]));
    }
    function evidencePhoto(photoId,inspId,lightId,author){
      let photo=getAfter(/databases/$(db)/documents/photos/$(photoId)).data;
      return photo.inspId==inspId && photo.lightId==lightId && photo.by==author;
    }
    function inspectionEvidence(id,data){
      let ts=data.get('thumbs',[]);
      let n=ts.size();
      let lightId=data.lightId;
      let author=data.inspector;
      return (n<1 || evidencePhoto(ts[0].id,id,lightId,author))
        && (n<2 || evidencePhoto(ts[1].id,id,lightId,author))
        && (n<3 || evidencePhoto(ts[2].id,id,lightId,author))
        && (n<4 || evidencePhoto(ts[3].id,id,lightId,author))
        && (n<5 || evidencePhoto(ts[4].id,id,lightId,author))
        && (n<6 || evidencePhoto(ts[5].id,id,lightId,author));
    }
    function validRep(data,key){
      let value=data.get(key,null);
      return value==null || (value is map && value.keys().hasOnly(['id','at','by','thumb'])
        && value.id is string && value.at is int && value.by==request.auth.uid
        && optionalImage(value,'thumb',160000));
    }
    function inspectionFields(){
      return ['lightId','code','dong','date','checks','faults','result','memo','inspector',
        'tiltDeg','pos','posDist','photo','thumbs','photoN','patrol','patrolId'];
    }
    function validInspection(data){
      return data.keys().hasOnly(inspectionFields())
        && data.inspector == request.auth.uid
        && data.lightId is string && data.date is int
        && data.checks is map && data.faults is list && data.faults.size()<=20 && validStatus(data.result)
        && thumbList(data) && optionalText(data,'memo',1000) && optionalText(data,'code',200)
        && optionalText(data,'dong',40) && optionalImage(data,'photo',900000)
        && (!('photoN' in data) || (data.photoN is int && data.photoN>=0 && data.photoN<=6));
    }
    function ownUnreviewedInspection(inspId, lightId){
      let inspection = getAfter(/databases/$(db)/documents/inspections/$(inspId)).data;
      return inspId is string && inspection.inspector == request.auth.uid
        && inspection.lightId == lightId && inspection.get('reviewedAt', null) == null;
    }

    // 최초 관리자는 scripts/admin-setup.cjs에서 승인된 UID로 역할과 잠금을 원자적으로 생성한다.
    match /roles/{uid} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }
    match /meta/setup { allow read: if signedIn(); allow write: if false; }

    // 사용자 표시 이름: 본인만 쓰고, 직원은 읽음
    match /users/{uid} { allow read: if isStaff(); allow write: if signedIn() && request.auth.uid == uid; }

    // 신규 대장 덮어쓰기에도 같은 필드 제한을 적용한다. delete/set로 이력을 지울 수 없다.
    match /lights/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() || (isStaff() && (
        (request.resource.data.keys().hasOnly(lightFieldKeys()) && validLightFields(request.resource.data)
          && request.resource.data.get('redoNote', null) == null
          && request.resource.data.get('photo', null) == null
          && validRep(request.resource.data,'repWide') && validRep(request.resource.data,'repPlate') && validRep(request.resource.data,'repAround')
          && (!('posSuggest' in request.resource.data) || ownPositionSuggestion(request.resource.data)))
        || newFieldLight(id, request.resource.data)));
      allow update: if (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['restoredAt'])
        && request.resource.data.restoredBy==request.auth.uid && request.resource.data.restoredAt is int
        && request.resource.data.restoredAt>resource.data.get('restoredAt',0))
        || ((resource.data.get('lastInspected',null)==null || (request.resource.data.get('lastInspected',null) is int && request.resource.data.lastInspected>=resource.data.lastInspected))
        && (isAdmin() || (isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(lightFieldKeys())
        && validLightFields(request.resource.data)
        && (resource.data.get('lastInspected',null)==null || (request.resource.data.get('lastInspected',null) is int && request.resource.data.lastInspected>=resource.data.lastInspected))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['repWide']) || validRep(request.resource.data,'repWide'))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['repPlate']) || validRep(request.resource.data,'repPlate'))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['repAround']) || validRep(request.resource.data,'repAround'))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['redoNote'])
          || request.resource.data.get('redoNote', null) == null)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photo'])
          || request.resource.data.get('photo', null) == null)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['posSuggest'])
          || ownPositionSuggestion(request.resource.data)))));
      allow delete: if isAdmin();
    }
    match /inspections/{id} {
      allow read: if isStaff();
      // 검수·재점검 관리 필드는 점검자 생성 요청에도 넣을 수 없다.
      allow create: if (validInspection(request.resource.data) && inspectionEvidence(id,request.resource.data) && isStaff()) || (isAdmin() && thumbList(request.resource.data));
      // 저장된 점검은 불변. 통신 재시도의 완전히 동일한 쓰기만 허용한다.
      allow update: if (isAdmin() && thumbList(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewedAt','reviewedBy']) || inspectionEvidence(id,request.resource.data))) || (isStaff() && resource.data.inspector == request.auth.uid
        && request.resource.data == resource.data);
      allow delete: if isAdmin();
    }
    match /reports/{id} { allow read, create: if isStaff(); allow update: if isAdmin(); allow delete: if isAdmin(); }
    match /patrols/{id} { allow read: if isStaff(); allow create: if isAdmin() || (isStaff() && request.resource.data.by == request.auth.uid); allow update: if isAdmin() || (isStaff() && resource.data.by==request.auth.uid && request.resource.data==resource.data); allow delete: if isAdmin(); }
    match /photos/{id} {
      allow read: if isStaff();
      allow create: if (signedIn()
        && request.resource.data.keys().hasOnly(['lightId','code','dong','inspId','label','note','data','w','h','at','by','kind','workId'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.lightId is string && imageData(request.resource.data.data,900000)
        && request.resource.data.at is int
        && (!('inspId' in request.resource.data)
          || ownUnreviewedInspection(request.resource.data.inspId, request.resource.data.lightId))
        && (!('workId' in request.resource.data) || ownWorkPhoto(request.resource.data)) && isStaff()) || isAdmin();
      // 작성자도 증빙 사진 내용을 덮어쓸 수 없다. 구버전의 최초 점검 연결만 허용한다.
      allow update: if isAdmin() || (isStaff() && resource.data.by == request.auth.uid && (
        request.resource.data == resource.data
        || (resource.data.get('inspId', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inspId'])
          && ownUnreviewedInspection(request.resource.data.inspId, resource.data.lightId))));
      allow delete: if isAdmin();
    }
    match /roads/{id} { allow read: if isStaff(); allow write: if isAdmin(); }

    function importedReportMatches(id,source,reportId){
      let report=getAfter(/databases/$(db)/documents/reports/$(reportId)).data;
      return report.ext==id && report.get('desc','')==source.get('desc','')
        && report.issue==source.issue && report.get('contact','')==source.get('contact','')
        && report.get('photo',null)==source.get('photo',null)
        && report.get('lat',null)==source.get('lat',null) && report.get('lng',null)==source.get('lng',null)
        && report.get('privacyExpiresAt',null)==source.get('privacyExpiresAt',null);
    }

    // 주민 입력은 App Check·빈도 제한·이미지 정규화를 거치는 서버 접수 함수만 생성한다.
    match /citizen_reports/{id} {
      allow create: if false;
      allow read: if isStaff();
      allow update: if isAdmin() || (isStaff()
        && resource.data.imported==false && request.resource.data.imported==true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imported','importedAt','importedBy','reportId','contact','photo'])
        && request.resource.data.importedAt is int
        && request.resource.data.get('importedBy',request.auth.uid)==request.auth.uid
        && request.resource.data.get('contact','')=='' && request.resource.data.get('photo','')==''
        && request.resource.data.reportId is string
        && importedReportMatches(id,resource.data,request.resource.data.reportId));
      allow delete: if isAdmin();
    }
    match /joinRequests/{uid} {
      allow read: if isAdmin() || (signedIn() && uid==request.auth.uid);
      allow create: if signedIn() && uid==request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','name','email','message','status','createdAt','updatedAt'])
        && request.resource.data.uid==uid && request.resource.data.status=='pending'
        && request.resource.data.email==request.auth.token.email
        && optionalText(request.resource.data,'name',80) && optionalText(request.resource.data,'message',500)
        && request.resource.data.createdAt is int && request.resource.data.updatedAt is int;
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt','updatedAt'])
          && resource.data.status=='pending' && request.resource.data.status in ['approved','rejected']
          && request.resource.data.reviewedBy==request.auth.uid
          && (request.resource.data.status!='approved' || getAfter(/databases/$(db)/documents/roles/$(uid)).data.role in ['admin','inspector']))
        || (signedIn() && uid==request.auth.uid && resource.data.status=='pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','message','updatedAt'])
          && optionalText(request.resource.data,'name',80) && optionalText(request.resource.data,'message',500)
          && request.resource.data.updatedAt is int);
      allow delete: if false;
    }
    match /auditEvents/{id} {allow read: if isStaff(); allow write: if false;}
    match /staffInvites/{id} {allow read,write: if false;}
    match /privateLimits/{id} {allow read,write: if false;}
    match /lightFields/{id} {allow read,write: if isAdmin();}
    match /settings/{id} {
      allow read: if isStaff();
      allow create,update: if isAdmin() && (id!='operations' || (
        request.resource.data.keys().hasOnly(['schemaVersion','inspectionDays','privacyDays','updatedAt','updatedBy'])
        && request.resource.data.schemaVersion==1
        && request.resource.data.inspectionDays is int && request.resource.data.inspectionDays>=1 && request.resource.data.inspectionDays<=3650
        && request.resource.data.privacyDays is int && request.resource.data.privacyDays>=1 && request.resource.data.privacyDays<=3650
        && request.resource.data.updatedAt is int && request.resource.data.updatedBy==request.auth.uid));
      allow delete: if isAdmin() && id!='operations';
    }
    function workVisible(data){let role=myRole();return role=='admin' || (role=='inspector' && data.assignedTo==request.auth.uid);}
    function ownWorkPhoto(data){
      let work=getAfter(/databases/$(db)/documents/workOrders/$(data.workId)).data;
      return data.kind=='work' && work.lightId==data.lightId && workVisible(work)
        && work.status in ['draft','assigned','in_progress','completed'];
    }
    function workPhoto(photoId,workId,lightId){
      let photo=getAfter(/databases/$(db)/documents/photos/$(photoId)).data;
      return photo.workId==workId && photo.lightId==lightId && imageData(photo.data,900000);
    }
    function workEvidence(id,data){
      let ps=data.afterPhotos;
      return ps.size()>0 && ps.size()<=6
        && workPhoto(ps[0],id,data.lightId)
        && (ps.size()<2 || workPhoto(ps[1],id,data.lightId)) && (ps.size()<3 || workPhoto(ps[2],id,data.lightId))
        && (ps.size()<4 || workPhoto(ps[3],id,data.lightId)) && (ps.size()<5 || workPhoto(ps[4],id,data.lightId))
        && (ps.size()<6 || workPhoto(ps[5],id,data.lightId));
    }
    function validWork(data){
      let accounted=data.get('accountedCost',0);
      let stock=data.get('stockApplied',{});
      return data.keys().hasOnly(['schemaVersion','lightId','code','dong','title','description','type','priority','status','assignedTo','dueAt','createdAt','createdBy','updatedAt','updatedBy','revision','reportIds','inspectionIds','beforePhotos','afterPhotos','completionNote','completedAt','completedBy','verificationNote','verifiedAt','verifiedBy','parts','costTotal','measurements','stockApplied','accountedCost'])
      && data.schemaVersion==1 && data.lightId is string && data.createdBy is string
      && optionalText(data,'title',200) && optionalText(data,'description',2000)
      && optionalText(data,'completionNote',2000) && optionalText(data,'verificationNote',2000)
      && data.type in ['수리','재점검','신설검토','철거','기타'] && data.priority in ['긴급','높음','보통','낮음']
      && data.status in ['draft','assigned','in_progress','completed','verified','cancelled']
      && data.assignedTo is string && data.createdAt is int && data.updatedAt is int && data.dueAt is int
      && data.revision is int && data.revision>=1 && data.updatedBy==request.auth.uid
      && data.reportIds is list && data.reportIds.size()<=50 && data.inspectionIds is list && data.inspectionIds.size()<=50
      && data.beforePhotos is list && data.beforePhotos.size()<=6 && data.afterPhotos is list && data.afterPhotos.size()<=6
      && data.parts is list && data.parts.size()<=50 && data.measurements is list && data.measurements.size()<=100
      && data.costTotal is number && data.costTotal>=0 && accounted is number && accounted>=0
      && stock is map && stock.keys().size()<=30;
    }
    function workTransition(old,next){return old==next
      || (old=='draft' && next in ['assigned','cancelled'])
      || (old=='assigned' && next in ['in_progress','cancelled'])
      || (old=='in_progress' && next in ['completed','assigned','cancelled'])
      || (old=='completed' && next in ['verified','in_progress'])
      || (old=='verified' && next=='assigned') || (old=='cancelled' && next=='draft');}
    function canUpdateWork(id){
      let role=myRole();
      let admin=role=='admin';
      let data=request.resource.data;
      let previous=resource.data;
      let changed=data.diff(previous).affectedKeys();
      return role in ['admin','inspector'] && validWork(data)
        && data.lightId==previous.lightId && data.createdBy==previous.createdBy
        && data.createdAt==previous.createdAt && data.revision==previous.revision+1
        && workTransition(previous.status,data.status)
        && (admin || (previous.assignedTo==request.auth.uid
          && changed.hasOnly(['status','updatedAt','updatedBy','revision','beforePhotos','afterPhotos','completionNote','completedAt','completedBy','parts','costTotal','measurements'])
          && ((previous.status=='assigned' && data.status=='in_progress')
            || (previous.status=='in_progress' && data.status in ['in_progress','completed']))))
        && (!changed.hasAny(['stockApplied','accountedCost']) || (admin && previous.status=='completed' && data.status=='verified'))
        && (data.status!='completed' || (workEvidence(id,data) && data.completedBy==request.auth.uid && data.completedAt is int))
        && (data.status!='verified' || (admin && workEvidence(id,data)
          && data.get('accountedCost',0)==data.costTotal && data.verifiedBy==request.auth.uid && data.verifiedAt is int));
    }
    match /workOrders/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() && validWork(request.resource.data)
        && request.resource.data.createdBy==request.auth.uid && request.resource.data.status in ['draft','assigned']
        && request.resource.data.revision==1 && request.resource.data.get('stockApplied',{}).size()==0 && request.resource.data.get('accountedCost',0)==0;
      allow update: if canUpdateWork(id);
      allow delete: if false;
    }
    function validInventory(data){
      return data.keys().hasOnly(['name','unit','quantity','unitCost','revision','updatedAt','updatedBy'])
        && optionalText(data,'name',120) && optionalText(data,'unit',40)
        && data.quantity is number && data.quantity>=0 && data.unitCost is number && data.unitCost>=0
        && data.revision is int && data.updatedBy==request.auth.uid && data.updatedAt is int;
    }
    match /inventory/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() && validInventory(request.resource.data) && request.resource.data.revision==1;
      allow update: if isAdmin() && validInventory(request.resource.data) && request.resource.data.revision==resource.data.revision+1;
      allow delete: if false;
    }
    match /inventoryMoves/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['itemId','delta','reason','at','by','revision','workId'])
        && request.resource.data.itemId is string && request.resource.data.delta is number
        && request.resource.data.by==request.auth.uid && request.resource.data.at is int
        && optionalText(request.resource.data,'reason',500) && request.resource.data.revision is int
        && getAfter(/databases/$(db)/documents/inventory/$(request.resource.data.itemId)).data.revision==request.resource.data.revision;
      allow update,delete: if false;
    }
    function workEventMatches(data){
      let work=getAfter(/databases/$(db)/documents/workOrders/$(data.workId)).data;
      let previous=exists(/databases/$(db)/documents/workOrders/$(data.workId))
        ?get(/databases/$(db)/documents/workOrders/$(data.workId)).data:{'revision':0,'status':'','accountedCost':0};
      let verified=previous.status=='completed' && work.status=='verified';
      let accounted=previous.get('accountedCost',0);
      return workVisible(work) && work.lightId==data.lightId && work.revision==data.revision && work.status==data.toStatus
        && work.updatedBy==data.by && work.updatedAt==data.at
        && work.revision==previous.revision+1 && data.fromStatus==previous.status
        && (!('createdAt' in data) || (data.createdAt is number && data.createdAt==work.createdAt))
        && (!('costTotal' in data) || (data.costTotal is number && data.costTotal==work.costTotal))
        && (!('costDelta' in data) || (data.costDelta is number && data.costDelta==(verified?work.costTotal-accounted:0)));
    }
    match /workEvents/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.keys().hasOnly(['workId','lightId','fromStatus','toStatus','type','note','at','by','revision','createdAt','costTotal','costDelta'])
        && request.resource.data.by==request.auth.uid && request.resource.data.at is int
        && optionalText(request.resource.data,'note',2000)
        && workEventMatches(request.resource.data);
      allow update,delete: if false;
    }
  }
}
