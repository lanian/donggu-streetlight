rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // ---- 역할: roles/{uid} = {role: admin|inspector|resident, name, at, by}
    function signedIn(){ return request.auth != null; }
    function myRole(){ let role=signedIn()?get(/databases/$(db)/documents/roles/$(request.auth.uid)).data:null;
      let maintenance=/databases/$(db)/documents/meta/operationalRestore;
      return exists(maintenance) && get(maintenance).data.get('status','')=='partial'?'':(role is map?role.get("role",""):""); }
    function isAdmin(){ return myRole() == "admin"; }
    function isStaff(){ return myRole() in ["admin","inspector"]; }
    function setupDone(){ return exists(/databases/$(db)/documents/meta/setup); }
    function validStatus(value){ return value in ['정상','점검필요','고장','수리중']; }
    function optionalText(data, key, max){ return data.get(key, '') is string && data.get(key, '').size() <= max; }

    // 점검자는 상태·표찰·대표 사진과 좌표 제안만 바꿀 수 있다.
    // 좌표 원본, 광원, 철거, 대장반영, 변경 이력 등은 관리자가 처리한다.
    function lightFieldKeys(){
      return ['status','lastInspected','lastResult','updatedAt','redoNote',
        'code','kind','dong','num','road','main','sub','plateFixed','plateFixedAt',
        'posSuggest','reps','photoId','photoT','photoAt','photoBy','photo','repWide','repPlate','repAround'];
    }
    function validLightFields(data){
      return (!('status' in data) || validStatus(data.status))
        && (!('lastResult' in data) || data.lastResult == null || validStatus(data.lastResult))
        && (!('code' in data) || optionalText(data, 'code', 200))
        && (!('updatedAt' in data) || data.updatedAt is int)
        && (!('lastInspected' in data) || data.lastInspected == null || data.lastInspected is int)
        && (!('posSuggest' in data) || data.posSuggest == null || (data.posSuggest is map
          && data.posSuggest.lat is number && data.posSuggest.lng is number));
    }
    function ownPositionSuggestion(data){
      return data.get('posSuggest', null) is map
        && data.posSuggest.by == request.auth.uid;
    }
    function newFieldLight(id, data){
      // 배포 대장(p...)에 임의의 좌표·철거 정보를 생성하는 우회를 막는다.
      return id.matches('(np|bd|gl)-.+')
        && data.keys().hasOnly(['code','dong','kind','num','road','main','sub','poleNo',
          'address','lampType','status','lastInspected','reg','noPlate','note',
          'foundAt','foundBy','updatedAt','photo','lat','lng','acc'])
        && data.reg == '미등록' && data.foundBy == request.auth.uid
        && data.code is string && data.code.size() > 0 && data.code.size() <= 200
        && data.foundAt is int && data.updatedAt is int
        && data.status == '정상' && data.lastInspected == null
        && (!('lat' in data) || (data.lat is number && data.lat >= -90 && data.lat <= 90))
        && (!('lng' in data) || (data.lng is number && data.lng >= -180 && data.lng <= 180));
    }
    function imageData(value, max){
      return value is string && value.size() <= max
        && (value == '' || value.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'));
    }
    function optionalImage(data,key,max){return data.get(key,null)==null || imageData(data[key],max);}
    // Thumbnail bytes are never used as a remote URL by the client. Validate their
    // shape here; original photo format and provenance are checked separately.
    function validThumb(t){return t is map && t.id is string && t.id.size()<=200
      && t.t is string && t.t.size()<=160000 && optionalText(t,'label',80);}
    function thumbList(data){
      let ts=data.get('thumbs',[]);
      let n=ts is list?ts.size():999;
      return n<=6
        && (n<1 || validThumb(ts[0])) && (n<2 || validThumb(ts[1]))
        && (n<3 || validThumb(ts[2])) && (n<4 || validThumb(ts[3]))
        && (n<5 || validThumb(ts[4])) && (n<6 || validThumb(ts[5]));
    }
    function evidencePhoto(photoId,inspId,lightId,author){
      let photo=getAfter(/databases/$(db)/documents/photos/$(photoId)).data;
      return photo.inspId==inspId && photo.lightId==lightId && photo.by==author;
    }
    function inspectionEvidence(id,data){
      let ts=data.get('thumbs',[]);
      let n=ts.size();
      let lightId=data.lightId;
      let author=data.inspector;
      return (n<1 || evidencePhoto(ts[0].id,id,lightId,author))
        && (n<2 || evidencePhoto(ts[1].id,id,lightId,author))
        && (n<3 || evidencePhoto(ts[2].id,id,lightId,author))
        && (n<4 || evidencePhoto(ts[3].id,id,lightId,author))
        && (n<5 || evidencePhoto(ts[4].id,id,lightId,author))
        && (n<6 || evidencePhoto(ts[5].id,id,lightId,author));
    }
    function validRep(data,key){
      let value=data.get(key,null);
      return value==null || (value is map && value.keys().hasOnly(['id','at','by','thumb'])
        && value.id is string && value.at is int && value.by==request.auth.uid
        && optionalImage(value,'thumb',160000));
    }
    function inspectionFields(){
      return ['lightId','code','dong','date','checks','faults','result','memo','inspector',
        'tiltDeg','pos','posDist','photo','thumbs','photoN','patrol','patrolId'];
    }
    function validInspection(data){
      return data.keys().hasOnly(inspectionFields())
        && data.inspector == request.auth.uid
        && data.lightId is string && data.date is int
        && data.checks is map && data.faults is list && data.faults.size()<=20 && validStatus(data.result)
        && thumbList(data) && optionalText(data,'memo',1000) && optionalText(data,'code',200)
        && optionalText(data,'dong',40) && optionalImage(data,'photo',900000)
        && (!('photoN' in data) || (data.photoN is int && data.photoN>=0 && data.photoN<=6));
    }
    function ownUnreviewedInspection(inspId, lightId){
      let inspection = getAfter(/databases/$(db)/documents/inspections/$(inspId)).data;
      return inspId is string && inspection.inspector == request.auth.uid
        && inspection.lightId == lightId && inspection.get('reviewedAt', null) == null;
    }

    // 최초 관리자는 scripts/admin-setup.cjs에서 승인된 UID로 역할과 잠금을 원자적으로 생성한다.
    match /roles/{uid} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }
    match /meta/setup { allow read: if signedIn(); allow write: if false; }

    // 사용자 표시 이름: 본인만 쓰고, 직원은 읽음
    match /users/{uid} { allow read: if isStaff(); allow write: if signedIn() && request.auth.uid == uid; }

    // 신규 대장 덮어쓰기에도 같은 필드 제한을 적용한다. delete/set로 이력을 지울 수 없다.
    match /lights/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() || (isStaff() && (
        (request.resource.data.keys().hasOnly(lightFieldKeys()) && validLightFields(request.resource.data)
          && request.resource.data.get('redoNote', null) == null
          && request.resource.data.get('photo', null) == null
          && validRep(request.resource.data,'repWide') && validRep(request.resource.data,'repPlate') && validRep(request.resource.data,'repAround')
          && (!('posSuggest' in request.resource.data) || ownPositionSuggestion(request.resource.data)))
        || newFieldLight(id, request.resource.data)));
      allow update: if (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['restoredAt'])
        && request.resource.data.restoredBy==request.auth.uid && request.resource.data.restoredAt is int
        && request.resource.data.restoredAt>resource.data.get('restoredAt',0))
        || ((resource.data.get('lastInspected',null)==null || (request.resource.data.get('lastInspected',null) is int && request.resource.data.lastInspected>=resource.data.lastInspected))
        && (isAdmin() || (isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(lightFieldKeys())
        && validLightFields(request.resource.data)
        && (resource.data.get('lastInspected',null)==null || (request.resource.data.get('lastInspected',null) is int && request.resource.data.lastInspected>=resource.data.lastInspected))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['repWide']) || validRep(request.resource.data,'repWide'))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['repPlate']) || validRep(request.resource.data,'repPlate'))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['repAround']) || validRep(request.resource.data,'repAround'))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['redoNote'])
          || request.resource.data.get('redoNote', null) == null)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photo'])
          || request.resource.data.get('photo', null) == null)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['posSuggest'])
          || ownPositionSuggestion(request.resource.data)))));
      allow delete: if isAdmin();
    }
    match /inspections/{id} {
      allow read: if isStaff();
      // 검수·재점검 관리 필드는 점검자 생성 요청에도 넣을 수 없다.
      allow create: if (validInspection(request.resource.data) && inspectionEvidence(id,request.resource.data) && isStaff()) || (isAdmin() && thumbList(request.resource.data));
      // 저장된 점검은 불변. 통신 재시도의 완전히 동일한 쓰기만 허용한다.
      allow update: if (isAdmin() && thumbList(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewedAt','reviewedBy']) || inspectionEvidence(id,request.resource.data))) || (isStaff() && resource.data.inspector == request.auth.uid
        && request.resource.data == resource.data);
      allow delete: if isAdmin();
    }
    function reportLinkKeys(){return ['lightId','code','dong','linkRevision','linkEventId','linkUpdatedBy'];}
    function inactiveReportWork(d){let key=d.get('workId','');let ref=/databases/$(db)/documents/workOrders/$(key==''?'__none__':key);
      return key=='' || !exists(ref) || get(ref).data.status in ['verified','cancelled'];}
    function reportWorkMatches(id,d){let key=d.get('workId','');let work=getAfter(/databases/$(db)/documents/workOrders/$(key)).data;
      return key is string && key.size()>0 && work.lightId==d.lightId && id in work.reportIds
        && (work.status in ['draft','assigned','in_progress','completed'] || (work.status=='verified' && d.status=='완료'
          && d.get('resolvedBy','')==request.auth.uid && d.get('resolvedAt',0)==work.verifiedAt));}
    function reportLight(d){return d.get('lightId','')==null?'':d.get('lightId','');}
    function reportRelink(id,d,old){let event=getAfter(/databases/$(db)/documents/reportEvents/$(d.linkEventId)).data;
      return d.diff(old).affectedKeys().hasOnly(['lightId','code','dong','linkRevision','linkEventId','linkUpdatedBy','updatedAt','workId'])
        && lightingId(d.linkEventId) && !exists(/databases/$(db)/documents/reportEvents/$(d.linkEventId))
        && d.linkRevision==old.get('linkRevision',0)+1 && d.linkUpdatedBy==request.auth.uid && d.updatedAt is int
        && event.reportId==id && event.toLightId==d.lightId && event.fromLightId==reportLight(old)
        && event.revision==d.linkRevision && event.by==request.auth.uid && event.at==d.updatedAt
        && (d.lightId==reportLight(old) ? d.get('workId','')==old.get('workId','') : inactiveReportWork(old) && d.get('workId','')=='');}
    match /reports/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && !request.resource.data.keys().hasAny(['linkRevision','linkEventId','linkUpdatedBy'])
        && (!request.resource.data.keys().hasAny(['workId']) || (isAdmin() && reportWorkMatches(id,request.resource.data)));
      allow update: if isAdmin()
        && (request.resource.data.diff(resource.data).affectedKeys().hasAny(reportLinkKeys())
          ? reportRelink(id,request.resource.data,resource.data)
          : (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['workId'])
            || ((resource.data.get('workId','')==request.resource.data.get('workId','') || inactiveReportWork(resource.data))
              && (request.resource.data.get('workId','')=='' || reportWorkMatches(id,request.resource.data)))));
      allow delete: if isAdmin();
    }
    match /reportEvents/{id}{
      allow read: if isStaff();
      allow create: if isAdmin() && lightingId(id)
        && request.resource.data.keys().hasOnly(['schemaVersion','type','reportId','fromLightId','toLightId','reason','by','at','revision','requestHash'])
        && request.resource.data.schemaVersion==1 && request.resource.data.type=='facility-linked'
        && lightingText(request.resource.data.reportId,180) && request.resource.data.reportId.size()>0
        && lightingText(request.resource.data.fromLightId,180) && lightingText(request.resource.data.toLightId,180) && request.resource.data.toLightId.size()>0
        && lightingText(request.resource.data.reason,500) && request.resource.data.reason.size()>0
        && request.resource.data.by==request.auth.uid && request.resource.data.at is int && request.resource.data.revision is int
        && request.resource.data.requestHash is string && request.resource.data.requestHash.matches('[a-f0-9]{64}')
        && getAfter(/databases/$(db)/documents/reports/$(request.resource.data.reportId)).data.linkEventId==id
        && reportRelink(request.resource.data.reportId,getAfter(/databases/$(db)/documents/reports/$(request.resource.data.reportId)).data,get(/databases/$(db)/documents/reports/$(request.resource.data.reportId)).data);
      allow update,delete: if false;
    }
    match /patrols/{id} { allow read: if isStaff(); allow create: if isAdmin() || (isStaff() && request.resource.data.by == request.auth.uid); allow update: if isAdmin() || (isStaff() && resource.data.by==request.auth.uid && request.resource.data==resource.data); allow delete: if isAdmin(); }
    match /photos/{id} {
      allow read: if isStaff();
      allow create: if (signedIn()
        && request.resource.data.keys().hasOnly(['lightId','code','dong','inspId','label','note','data','w','h','at','by','kind','workId'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.lightId is string && imageData(request.resource.data.data,900000)
        && request.resource.data.at is int
        && (!('inspId' in request.resource.data)
          || ownUnreviewedInspection(request.resource.data.inspId, request.resource.data.lightId))
        && (!('workId' in request.resource.data) || ownWorkPhoto(request.resource.data)) && isStaff()) || isAdmin();
      // 작성자도 증빙 사진 내용을 덮어쓸 수 없다. 구버전의 최초 점검 연결만 허용한다.
      allow update: if isAdmin() || (isStaff() && resource.data.by == request.auth.uid && (
        request.resource.data == resource.data
        || (resource.data.get('inspId', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inspId'])
          && ownUnreviewedInspection(request.resource.data.inspId, resource.data.lightId))));
      allow delete: if isAdmin();
    }
    match /roads/{id} { allow read: if isStaff(); allow write: if isAdmin(); }

    function importedReportMatches(id,source,reportId){
      let report=getAfter(/databases/$(db)/documents/reports/$(reportId)).data;
      return report.ext==id && report.get('desc','')==source.get('desc','')
        && report.issue==source.issue && report.get('contact','')==source.get('contact','')
        && report.get('photo',null)==source.get('photo',null)
        && report.get('lat',null)==source.get('lat',null) && report.get('lng',null)==source.get('lng',null)
        && report.get('privacyExpiresAt',null)==source.get('privacyExpiresAt',null);
    }

    // 주민 입력은 App Check·빈도 제한·이미지 정규화를 거치는 서버 접수 함수만 생성한다.
    match /citizen_reports/{id} {
      allow create: if false;
      allow read: if isStaff();
      allow update: if isAdmin() || (isStaff()
        && resource.data.imported==false && request.resource.data.imported==true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imported','importedAt','importedBy','reportId','contact','photo'])
        && request.resource.data.importedAt is int
        && request.resource.data.get('importedBy',request.auth.uid)==request.auth.uid
        && request.resource.data.get('contact','')=='' && request.resource.data.get('photo','')==''
        && request.resource.data.reportId is string
        && importedReportMatches(id,resource.data,request.resource.data.reportId));
      allow delete: if isAdmin();
    }
    match /joinRequests/{uid} {
      allow read: if isAdmin() || (signedIn() && uid==request.auth.uid);
      allow create: if signedIn() && uid==request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','name','email','message','status','createdAt','updatedAt'])
        && request.resource.data.uid==uid && request.resource.data.status=='pending'
        && request.resource.data.email==request.auth.token.email
        && optionalText(request.resource.data,'name',80) && optionalText(request.resource.data,'message',500)
        && request.resource.data.createdAt is int && request.resource.data.updatedAt is int;
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt','updatedAt'])
          && resource.data.status=='pending' && request.resource.data.status in ['approved','rejected']
          && request.resource.data.reviewedBy==request.auth.uid
          && (request.resource.data.status!='approved' || getAfter(/databases/$(db)/documents/roles/$(uid)).data.role in ['admin','inspector']))
        || (signedIn() && uid==request.auth.uid && resource.data.status=='pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','message','updatedAt'])
          && optionalText(request.resource.data,'name',80) && optionalText(request.resource.data,'message',500)
          && request.resource.data.updatedAt is int);
      allow delete: if false;
    }
    match /auditEvents/{id} {allow read: if isStaff(); allow write: if false;}
    match /restoreOperations/{id} {allow read: if isAdmin(); allow write: if false;}
    match /systemHealth/{id} {allow read,write: if false;}
    match /staffInvites/{id} {allow read,write: if false;}
    match /privateLimits/{id} {allow read,write: if false;}
    match /lightFields/{id} {allow read,write: if isAdmin();}
    match /settings/{id} {
      allow read: if isStaff();
      allow create,update: if isAdmin() && (id!='operations' || (
        request.resource.data.keys().hasOnly(['schemaVersion','inspectionDays','privacyDays','updatedAt','updatedBy'])
        && request.resource.data.schemaVersion==1
        && request.resource.data.inspectionDays is int && request.resource.data.inspectionDays>=1 && request.resource.data.inspectionDays<=3650
        && request.resource.data.privacyDays is int && request.resource.data.privacyDays>=1 && request.resource.data.privacyDays<=3650
        && request.resource.data.updatedAt is int && request.resource.data.updatedBy==request.auth.uid));
      allow delete: if isAdmin() && id!='operations';
    }
    function lightingId(value){return value is string && value.matches('[A-Za-z0-9_-]{1,180}')
      && !(value in ['__proto__','prototype','constructor']);}
    function lightingText(value,max){return value is string && value.size()<=max;}
    function lightingSourceKeys(){return ['sourceAgency','sourceRecordId','sourceDataset','sourceUpdatedAt','importedAt','importBatchId'];}
    function validLightingSource(data){return !data.keys().hasAny(lightingSourceKeys()) || (
      data.keys().hasAll(lightingSourceKeys()) && data.kind=='source'
      && lightingText(data.sourceAgency,100) && data.sourceAgency.size()>0
      && lightingText(data.sourceRecordId,180) && data.sourceRecordId.size()>0
      && lightingText(data.sourceDataset,300) && data.sourceDataset.size()>0
      && data.sourceUpdatedAt is int && data.sourceUpdatedAt>=0 && data.sourceUpdatedAt<=request.time.toMillis()+300000
      && data.importedAt is int && data.importedAt>0 && data.importedAt<=request.time.toMillis()+300000 && lightingId(data.importBatchId));}
    function validLightingOrigin(d){return !d.keys().hasAny(['originKind','originId','originPointId','positionAccuracy']) || (
      d.keys().hasAll(['originKind','originId','originPointId','positionAccuracy']) && d.kind=='observation'
      && d.originKind in ['patrol','task'] && lightingText(d.originId,180) && d.originId.size()>0
      && lightingText(d.originPointId,180) && d.positionAccuracy is number && d.positionAccuracy>=0 && d.positionAccuracy<=10000);}
    function validLighting(data){
      return data.keys().hasOnly(['schemaVersion','kind','label','category','operator','lat','lng','radius','strength','status','level',
        'schedule','startMinute','endMinute','observedAt','validDays','nightConfirmed','lux','instrument','note','linkedLightId','distinct','removed',
        'createdAt','createdBy','updatedAt','updatedBy','revision','operationId','sourceAgency','sourceRecordId','sourceDataset','sourceUpdatedAt','importedAt','importBatchId','originKind','originId','originPointId','positionAccuracy'])
        && data.schemaVersion==1 && data.kind in ['source','observation']
        && lightingText(data.label,100) && data.label.size()>0 && lightingText(data.operator,100)
        && data.category in ['other_public','private','shop','building','unknown','field']
        && data.lat is number && data.lat>=-90 && data.lat<=90 && data.lng is number && data.lng>=-180 && data.lng<=180
        && data.radius is number && data.radius>=5 && data.radius<=(data.kind=='source'?80:30)
        && data.strength in ['low','medium','high'] && data.status in ['on','off','unknown']
        && data.level in ['bright','adequate','dark','unknown'] && data.schedule in ['always','hours','unknown']
        && data.startMinute is int && data.startMinute>=0 && data.startMinute<=1439
        && data.endMinute is int && data.endMinute>=0 && data.endMinute<=1439
        && (data.schedule!='hours' || data.startMinute!=data.endMinute)
        && data.observedAt is int && data.observedAt>0 && data.observedAt<=request.time.toMillis()+300000
        && data.observedAt<=data.updatedAt+300000 && data.validDays is int && data.validDays>=1 && data.validDays<=365
        && data.nightConfirmed is bool && data.distinct is bool && data.removed is bool
        && (data.lux==null || (data.lux is number && data.lux>=0 && data.lux<=200000 && data.instrument.size()>0))
        && lightingText(data.instrument,100) && lightingText(data.note,1000) && lightingText(data.linkedLightId,180)
        && data.createdAt is int && data.createdAt>0 && data.updatedAt is int && data.updatedAt>=data.createdAt
        && data.updatedAt<=request.time.toMillis()+300000 && lightingText(data.createdBy,128) && data.createdBy.size()>0
        && data.updatedBy==request.auth.uid && data.revision is int && data.revision>=1 && data.revision<=9007199254740991
        && lightingId(data.operationId) && validLightingSource(data) && validLightingOrigin(data);
    }
    function lightingReceiptMatches(receipt,data,id){
      return receipt.recordId==id && receipt.by==request.auth.uid && receipt.by==data.updatedBy
        && receipt.at==data.updatedAt && receipt.revision==data.revision;
    }
    function newLightingReceipt(id,data){
      let ref=/databases/$(db)/documents/lightingOperations/$(data.operationId);
      return !exists(ref) && lightingReceiptMatches(getAfter(ref).data,data,id);
    }
    match /lightingContext/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && lightingId(id) && validLighting(request.resource.data)
        && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.resource.data.updatedAt
        && request.resource.data.revision==1 && request.resource.data.removed==false
        && (!request.resource.data.keys().hasAny(lightingSourceKeys()) || (isAdmin()
          && request.resource.data.status=='unknown' && request.resource.data.schedule=='unknown' && request.resource.data.nightConfirmed==false
          && request.resource.data.level=='unknown' && request.resource.data.lux==null && request.resource.data.distinct==false && request.resource.data.linkedLightId==''))
        && newLightingReceipt(id,request.resource.data);
      allow update: if isStaff() && lightingId(id) && validLighting(request.resource.data)
        && (isAdmin() || resource.data.createdBy==request.auth.uid)
        && request.resource.data.createdBy==resource.data.createdBy && request.resource.data.createdAt==resource.data.createdAt
        && (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(lightingSourceKeys()))
        && request.resource.data.revision==resource.data.revision+1 && newLightingReceipt(id,request.resource.data);
      // Keep an auditable tombstone. A deleted observation cannot silently reappear on retry.
      allow delete: if false;
    }
    function validLightingOperation(id,data){
      let ref=/databases/$(db)/documents/lightingContext/$(data.recordId);
      let after=getAfter(ref).data;
      let previous=exists(ref)?get(ref).data:{'revision':0};
      return data.keys().hasOnly(['schemaVersion','recordId','by','at','revision','requestHash']) && data.schemaVersion==1
        && lightingId(data.recordId) && lightingId(id) && data.by==request.auth.uid && data.at is int && data.revision is int
        && data.requestHash is string && data.requestHash.matches('[a-f0-9]{64}')
        && after.operationId==id && lightingReceiptMatches(data,after,data.recordId)
        && after.revision==previous.revision+1;
    }
    match /lightingOperations/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && validLightingOperation(id,request.resource.data);
      allow update,delete: if false;
    }
    function lightingWorkflowMeta(d){return d.schemaVersion==1 && d.createdAt is int && d.createdAt>0
      && lightingText(d.createdBy,128) && d.createdBy.size()>0 && d.updatedAt is int && d.updatedAt>=d.createdAt
      && d.updatedAt<=request.time.toMillis()+300000 && d.updatedBy==request.auth.uid
      && d.revision is int && d.revision>=1 && d.revision<=9007199254740991 && lightingId(d.operationId);}
    // Area decisions change screening scope, so only administrators may change them.
    // Keep both the active record and an immutable complete version in the same write.
    function lightingAreaPoint(p){
      // abs() rejects non-numbers; finite bounds reject NaN/Infinity; keys() requires a map.
      return p.keys().hasOnly(['lat','lng']) && math.abs(p.lat)<=85 && math.abs(p.lng)<=180;}
    // The area and its identical receipt snapshot each validate half of the vertices.
    // The atomic equality prevents unvalidated tails and bounds the per-write rule work.
    function lightingAreaVertices(v){let n=v.size();return v is list && n>=3 && n<=32
      && lightingAreaPoint(v[0])
      && lightingAreaPoint(v[1])
      && lightingAreaPoint(v[2])
      && (n<=3 || lightingAreaPoint(v[3]))
      && (n<=4 || lightingAreaPoint(v[4]))
      && (n<=5 || lightingAreaPoint(v[5]))
      && (n<=6 || lightingAreaPoint(v[6]))
      && (n<=7 || lightingAreaPoint(v[7]))
      && (n<=8 || lightingAreaPoint(v[8]))
      && (n<=9 || lightingAreaPoint(v[9]))
      && (n<=10 || lightingAreaPoint(v[10]))
      && (n<=11 || lightingAreaPoint(v[11]))
      && (n<=12 || lightingAreaPoint(v[12]))
      && (n<=13 || lightingAreaPoint(v[13]))
      && (n<=14 || lightingAreaPoint(v[14]))
      && (n<=15 || lightingAreaPoint(v[15]));}
    function lightingAreaFinalVertices(v){let n=v.size();return v is list && n>=3 && n<=32
      && (n<=16 || lightingAreaPoint(v[16]))
      && (n<=17 || lightingAreaPoint(v[17]))
      && (n<=18 || lightingAreaPoint(v[18]))
      && (n<=19 || lightingAreaPoint(v[19]))
      && (n<=20 || lightingAreaPoint(v[20]))
      && (n<=21 || lightingAreaPoint(v[21]))
      && (n<=22 || lightingAreaPoint(v[22]))
      && (n<=23 || lightingAreaPoint(v[23]))
      && (n<=24 || lightingAreaPoint(v[24]))
      && (n<=25 || lightingAreaPoint(v[25]))
      && (n<=26 || lightingAreaPoint(v[26]))
      && (n<=27 || lightingAreaPoint(v[27]))
      && (n<=28 || lightingAreaPoint(v[28]))
      && (n<=29 || lightingAreaPoint(v[29]))
      && (n<=30 || lightingAreaPoint(v[30]))
      && (n<=31 || lightingAreaPoint(v[31]));}
    function validLightingArea(d){return d.keys().hasOnly(['schemaVersion','label','effect','reason','note','shape','lat','lng','radius','vertices','disabled','createdAt','createdBy','updatedAt','updatedBy','revision','operationId'])
      && lightingWorkflowMeta(d) && lightingText(d.label,100) && d.label.size()>0 && lightingText(d.note,1000)
      && d.effect in ['exclude','include'] && d.reason in ['mountain','private','non_walkway','water','other','public_path']
      && (d.effect!='include' || d.reason in ['public_path','other'])
      && d.lat is number && d.lat>=-85 && d.lat<=85 && d.lng is number && d.lng>=-180 && d.lng<=180
      && d.radius is number && d.disabled is bool
      && ((d.shape=='circle' && d.radius>=5 && d.radius<=1000 && d.vertices is list && d.vertices.size()==0)
        || (d.shape=='polygon' && d.radius==0 && lightingAreaVertices(d.vertices)));}
    function newLightingAreaReceipt(id,d){let ref=/databases/$(db)/documents/lightingAreaOperations/$(d.operationId);let receipt=getAfter(ref).data;
      return !exists(ref) && lightingReceiptMatches(receipt,d,id) && receipt.snapshot==d;}
    match /lightingAreas/{id}{
      allow read: if isStaff();
      allow create: if isAdmin() && request.resource.data.revision==1 && request.resource.data.disabled==false
        && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.resource.data.updatedAt
        && lightingId(id) && validLightingArea(request.resource.data)
        && newLightingAreaReceipt(id,request.resource.data);
      allow update: if isAdmin() && request.resource.data.revision==resource.data.revision+1
        && request.resource.data.createdBy==resource.data.createdBy && request.resource.data.createdAt==resource.data.createdAt
        && request.resource.data.updatedAt>=resource.data.updatedAt && lightingId(id) && validLightingArea(request.resource.data)
        && newLightingAreaReceipt(id,request.resource.data);
      allow delete: if false;
    }
    function validLightingAreaOperation(id,d){let ref=/databases/$(db)/documents/lightingAreas/$(d.recordId);let a=getAfter(ref).data;
      let old=exists(ref)?get(ref).data:{'revision':0,'operationId':''};
      return d.keys().hasOnly(['schemaVersion','recordId','by','at','revision','requestHash','snapshot']) && d.schemaVersion==1
        && lightingId(id) && lightingId(d.recordId) && d.by==request.auth.uid && d.at is int && d.revision is int
        && d.requestHash is string && d.requestHash.matches('[a-f0-9]{64}') && d.snapshot is map && d.snapshot==a
        && a.operationId==id && old.operationId!=id && lightingReceiptMatches(d,a,d.recordId) && a.revision==old.revision+1
        && (a.shape!='polygon' || lightingAreaFinalVertices(a.vertices));}
    match /lightingAreaOperations/{id}{
      allow read: if isStaff();
      allow create: if isAdmin() && validLightingAreaOperation(id,request.resource.data);
      allow update,delete: if false;
    }
    function workflowReceipt(d,id,entity){let ref=/databases/$(db)/documents/lightingWorkflowOperations/$(d.operationId);let r=getAfter(ref).data;
      return !exists(ref) && r.recordId==id && r.entity==entity && r.by==d.updatedBy && r.at==d.updatedAt && r.revision==d.revision;}
    function validLightingTask(d){return d.keys().hasOnly(['schemaVersion','title','lat','lng','radius','note','originKind','originId','evidenceIds','assignedTo','dueAt','reviewMinute','status','observationId','completionNote','completedAt','completedBy','createdAt','createdBy','updatedAt','updatedBy','revision','operationId'])
      && lightingWorkflowMeta(d) && lightingText(d.title,120) && d.title.size()>0 && lightingText(d.note,1500)
      && d.lat is number && d.lat>=-90 && d.lat<=90 && d.lng is number && d.lng>=-180 && d.lng<=180
      && d.radius is number && d.radius>=5 && d.radius<=80
      && d.originKind in ['candidate','record','patrol','manual'] && lightingText(d.originId,180)
      && d.evidenceIds is list && d.evidenceIds.size()<=20
      && lightingText(d.assignedTo,128) && d.assignedTo.size()>0 && d.dueAt is int && d.dueAt>0
      && d.reviewMinute is int && d.reviewMinute>=0 && d.reviewMinute<=1439
      && d.status in ['open','completed','cancelled'] && lightingText(d.observationId,180) && lightingText(d.completionNote,1000)
      && d.completedAt is int && lightingText(d.completedBy,128)
      && (d.status=='completed' ? (d.observationId.size()>0 && d.completionNote.size()>0 && d.completedAt==d.updatedAt && d.completedBy==request.auth.uid)
        : (d.observationId=='' && d.completedAt==0 && d.completedBy==''));}
    function lightingTaskEvidence(d){let o=getAfter(/databases/$(db)/documents/lightingContext/$(d.observationId)).data;
      return o.kind=='observation' && o.removed==false && o.nightConfirmed==true && o.level in ['bright','adequate','dark']
        && latlng.value(d.lat,d.lng).distance(latlng.value(o.lat,o.lng))<=d.radius+o.radius
        && o.observedAt>=d.createdAt-300000 && o.observedAt<=d.updatedAt+300000 && o.observedAt+o.validDays*86400000>=d.updatedAt
        && (o.schedule=='always' || (o.schedule=='hours' && (o.startMinute<o.endMinute
          ? d.reviewMinute>=o.startMinute && d.reviewMinute<o.endMinute : d.reviewMinute>=o.startMinute || d.reviewMinute<o.endMinute)));
    }
    function lightingAssignee(d){return get(/databases/$(db)/documents/roles/$(d.assignedTo)).data.role in ['admin','inspector'];}
    match /lightingTasks/{id}{
      allow read: if isStaff();
      allow create: if isStaff() && lightingId(id) && validLightingTask(request.resource.data)
        && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.resource.data.updatedAt
        && request.resource.data.revision==1 && request.resource.data.status=='open'
        && (request.resource.data.assignedTo==request.auth.uid || (isAdmin() && lightingAssignee(request.resource.data)))
        && workflowReceipt(request.resource.data,id,'task');
      allow update: if isStaff() && validLightingTask(request.resource.data)
        && request.resource.data.createdBy==resource.data.createdBy && request.resource.data.createdAt==resource.data.createdAt
        && request.resource.data.originKind==resource.data.originKind && request.resource.data.originId==resource.data.originId
        && request.resource.data.revision==resource.data.revision+1
        && ((resource.data.status=='open' && (isAdmin() || (resource.data.assignedTo==request.auth.uid && request.resource.data.assignedTo==resource.data.assignedTo)))
          || (isAdmin() && resource.data.status in ['completed','cancelled'] && request.resource.data.status=='open'))
        && (request.resource.data.assignedTo==resource.data.assignedTo || lightingAssignee(request.resource.data))
        && (request.resource.data.status!='completed' || lightingTaskEvidence(request.resource.data))
        && workflowReceipt(request.resource.data,id,'task');
      allow delete: if false;
    }
    function validLightingRun(d){return d.keys().hasOnly(['schemaVersion','modelVersion','reviewedAt','minute','mode','dong','facilityKind','registryCount','contextCount','roadCount','candidateCount','inputDigest','inputVersionsJson','settingsJson','candidatesJson','evaluationJson','payloadBytes','createdAt','createdBy','updatedAt','updatedBy','revision','operationId'])
      && lightingWorkflowMeta(d) && lightingText(d.modelVersion,64) && d.modelVersion.size()>0
      && d.reviewedAt is int && d.reviewedAt>0 && d.reviewedAt<=request.time.toMillis()+300000
      && d.minute is int && d.minute>=0 && d.minute<=1439 && d.mode in ['roads','pairs'] && lightingText(d.dong,80) && lightingText(d.facilityKind,30)
      && d.registryCount is int && d.registryCount>=0 && d.registryCount<=100000 && d.contextCount is int && d.contextCount>=0 && d.contextCount<=100000
      && d.roadCount is int && d.roadCount>=0 && d.roadCount<=100000 && d.candidateCount is int && d.candidateCount>=0 && d.candidateCount<=100000
      && d.inputDigest is string && d.inputDigest.matches('[a-f0-9]{64}')
      && lightingText(d.inputVersionsJson,300000) && lightingText(d.settingsJson,12000) && lightingText(d.candidatesJson,300000) && lightingText(d.evaluationJson,180000)
      && d.payloadBytes is int && d.payloadBytes>0 && d.payloadBytes<=600000
      && d.inputVersionsJson.toUtf8().size()+d.settingsJson.toUtf8().size()+d.candidatesJson.toUtf8().size()+d.evaluationJson.toUtf8().size()<=600000;}
    match /lightingRuns/{id}{
      allow read: if isStaff();
      allow create: if isStaff() && lightingId(id) && validLightingRun(request.resource.data)
        && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.resource.data.updatedAt
        && request.resource.data.revision==1 && workflowReceipt(request.resource.data,id,'run');
      allow update,delete: if false;
    }
    function validWorkflowOperation(id,d){let ref=d.entity=='task'?/databases/$(db)/documents/lightingTasks/$(d.recordId):/databases/$(db)/documents/lightingRuns/$(d.recordId);
      let a=getAfter(ref).data;let old=exists(ref)?get(ref).data:{'revision':0};
      return d.keys().hasOnly(['schemaVersion','entity','recordId','by','at','revision','requestHash']) && d.schemaVersion==1
        && d.entity in ['task','run'] && lightingId(id) && lightingId(d.recordId) && d.by==request.auth.uid
        && d.at is int && d.revision is int && d.requestHash is string && d.requestHash.matches('[a-f0-9]{64}')
        && a.operationId==id && a.updatedBy==d.by && a.updatedAt==d.at && a.revision==d.revision && a.revision==old.revision+1;}
    match /lightingWorkflowOperations/{id}{allow read: if isStaff();allow create: if isStaff() && validWorkflowOperation(id,request.resource.data);allow update,delete: if false;}
    function workVisible(data){let role=myRole();return role=='admin' || (role=='inspector' && data.assignedTo==request.auth.uid);}
    function ownWorkPhoto(data){
      let work=getAfter(/databases/$(db)/documents/workOrders/$(data.workId)).data;
      return data.kind=='work' && work.lightId==data.lightId && workVisible(work)
        && work.status in ['draft','assigned','in_progress','completed'];
    }
    function workPhoto(photoId,workId,lightId){
      let photo=getAfter(/databases/$(db)/documents/photos/$(photoId)).data;
      return photo.workId==workId && photo.lightId==lightId && imageData(photo.data,900000);
    }
    function workEvidence(id,data){
      let ps=data.afterPhotos;
      return ps.size()>0 && ps.size()<=6
        && workPhoto(ps[0],id,data.lightId)
        && (ps.size()<2 || workPhoto(ps[1],id,data.lightId)) && (ps.size()<3 || workPhoto(ps[2],id,data.lightId))
        && (ps.size()<4 || workPhoto(ps[3],id,data.lightId)) && (ps.size()<5 || workPhoto(ps[4],id,data.lightId))
        && (ps.size()<6 || workPhoto(ps[5],id,data.lightId));
    }
    function validWork(data){
      let accounted=data.get('accountedCost',0);
      let stock=data.get('stockApplied',{});
      return data.keys().hasOnly(['schemaVersion','lightId','code','dong','title','description','type','priority','status','assignedTo','dueAt','createdAt','createdBy','updatedAt','updatedBy','revision','reportIds','inspectionIds','beforePhotos','afterPhotos','completionNote','completedAt','completedBy','verificationNote','verifiedAt','verifiedBy','parts','costTotal','measurements','stockApplied','accountedCost'])
      && data.schemaVersion==1 && data.lightId is string && data.createdBy is string
      && optionalText(data,'title',200) && optionalText(data,'description',2000)
      && optionalText(data,'completionNote',2000) && optionalText(data,'verificationNote',2000)
      && data.type in ['수리','재점검','신설검토','철거','기타'] && data.priority in ['긴급','높음','보통','낮음']
      && data.status in ['draft','assigned','in_progress','completed','verified','cancelled']
      && data.assignedTo is string && data.createdAt is int && data.updatedAt is int && data.dueAt is int
      && data.revision is int && data.revision>=1 && data.updatedBy==request.auth.uid
      && data.reportIds is list && data.reportIds.size()<=50 && data.inspectionIds is list && data.inspectionIds.size()<=50
      && data.beforePhotos is list && data.beforePhotos.size()<=6 && data.afterPhotos is list && data.afterPhotos.size()<=6
      && data.parts is list && data.parts.size()<=50 && data.measurements is list && data.measurements.size()<=100
      && data.costTotal is number && data.costTotal>=0 && accounted is number && accounted>=0
      && stock is map && stock.keys().size()<=30;
    }
    function workTransition(old,next){return old==next
      || (old=='draft' && next in ['assigned','cancelled'])
      || (old=='assigned' && next in ['in_progress','cancelled'])
      || (old=='in_progress' && next in ['completed','assigned','cancelled'])
      || (old=='completed' && next in ['verified','in_progress'])
      || (old=='verified' && next=='assigned') || (old=='cancelled' && next=='draft');}
    function canUpdateWork(id){
      let role=myRole();
      let admin=role=='admin';
      let data=request.resource.data;
      let previous=resource.data;
      let changed=data.diff(previous).affectedKeys();
      return role in ['admin','inspector'] && validWork(data)
        && data.lightId==previous.lightId && data.createdBy==previous.createdBy
        && data.createdAt==previous.createdAt && data.revision==previous.revision+1
        && workTransition(previous.status,data.status)
        && (admin || (previous.assignedTo==request.auth.uid
          && changed.hasOnly(['status','updatedAt','updatedBy','revision','beforePhotos','afterPhotos','completionNote','completedAt','completedBy','parts','costTotal','measurements'])
          && ((previous.status=='assigned' && data.status=='in_progress')
            || (previous.status=='in_progress' && data.status in ['in_progress','completed']))))
        && (!changed.hasAny(['stockApplied','accountedCost']) || (admin && previous.status=='completed' && data.status=='verified'))
        && (data.status!='completed' || (workEvidence(id,data) && data.completedAt is int
          && (data.completedBy==request.auth.uid || (admin && previous.status=='completed'
            && changed.hasOnly(['reportIds','revision','updatedAt','updatedBy'])))))
        && (data.status!='verified' || (admin && workEvidence(id,data)
          && data.get('accountedCost',0)==data.costTotal && data.verifiedBy==request.auth.uid && data.verifiedAt is int));
    }
    match /workOrders/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() && validWork(request.resource.data)
        && request.resource.data.createdBy==request.auth.uid && request.resource.data.status in ['draft','assigned']
        && request.resource.data.revision==1 && request.resource.data.get('stockApplied',{}).size()==0 && request.resource.data.get('accountedCost',0)==0;
      allow update: if canUpdateWork(id);
      allow delete: if false;
    }
    function validInventory(data){
      return data.keys().hasOnly(['name','unit','quantity','unitCost','revision','updatedAt','updatedBy'])
        && optionalText(data,'name',120) && optionalText(data,'unit',40)
        && data.quantity is number && data.quantity>=0 && data.unitCost is number && data.unitCost>=0
        && data.revision is int && data.updatedBy==request.auth.uid && data.updatedAt is int;
    }
    match /inventory/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() && validInventory(request.resource.data) && request.resource.data.revision==1;
      allow update: if isAdmin() && validInventory(request.resource.data) && request.resource.data.revision==resource.data.revision+1;
      allow delete: if false;
    }
    match /inventoryMoves/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['itemId','delta','reason','at','by','revision','workId'])
        && request.resource.data.itemId is string && request.resource.data.delta is number
        && request.resource.data.by==request.auth.uid && request.resource.data.at is int
        && optionalText(request.resource.data,'reason',500) && request.resource.data.revision is int
        && getAfter(/databases/$(db)/documents/inventory/$(request.resource.data.itemId)).data.revision==request.resource.data.revision;
      allow update,delete: if false;
    }
    function workEventMatches(data){
      let work=getAfter(/databases/$(db)/documents/workOrders/$(data.workId)).data;
      let previous=exists(/databases/$(db)/documents/workOrders/$(data.workId))
        ?get(/databases/$(db)/documents/workOrders/$(data.workId)).data:{'revision':0,'status':'','accountedCost':0};
      let verified=previous.status=='completed' && work.status=='verified';
      let accounted=previous.get('accountedCost',0);
      return workVisible(work) && work.lightId==data.lightId && work.revision==data.revision && work.status==data.toStatus
        && work.updatedBy==data.by && work.updatedAt==data.at
        && work.revision==previous.revision+1 && data.fromStatus==previous.status
        && (!('createdAt' in data) || (data.createdAt is number && data.createdAt==work.createdAt))
        && (!('costTotal' in data) || (data.costTotal is number && data.costTotal==work.costTotal))
        && (!('costDelta' in data) || (data.costDelta is number && data.costDelta==(verified?work.costTotal-accounted:0)));
    }
    match /workEvents/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.keys().hasOnly(['workId','lightId','fromStatus','toStatus','type','note','at','by','revision','createdAt','costTotal','costDelta','requestHash'])
        && request.resource.data.by==request.auth.uid && request.resource.data.at is int
        && optionalText(request.resource.data,'note',2000)
        && (!('requestHash' in request.resource.data) || (request.resource.data.requestHash is string && request.resource.data.requestHash.matches('[a-f0-9]{64}')))
        && workEventMatches(request.resource.data);
      allow update,delete: if false;
    }
  }
}
